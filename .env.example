# ── Modo padrão ────────────────────────────────────────────
# template = vídeo animado por código a partir das imagens do anúncio (grátis; só o roteiro usa Claude)
# ai       = cenas e clipes gerados por IA no fal.ai (pago)
VIDEO_MODE=template

# ── Provedores ─────────────────────────────────────────────
# "mock" = grátis/offline, só pra testar o fluxo.
LLM_PROVIDER=mock          # anthropic | mock
IMAGE_PROVIDER=mock        # fal | mock
VIDEO_PROVIDER=kenburns    # fal | kenburns (zoom/pan local, grátis)
TTS_PROVIDER=mock          # elevenlabs | mock (áudio mudo)

# ── Roteiro (Claude) ───────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Imagem e vídeo (fal.ai) ────────────────────────────────
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/nano-banana-2/edit
FAL_IMAGE_USD=0.08
FAL_VIDEO_MODEL=bytedance/seedance-2.5/image-to-video
FAL_VIDEO_RESOLUTION=480p   # 480p ~US$0.22/s · 720p ~US$0.47/s · 1080p ~US$1.16/s
FAL_VIDEO_USD_PER_SEC=0.2205

# ── Narração (ElevenLabs) ──────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Jeito da voz: estabilidade maior = mais calma/constante; style 0 = mais natural; speed 0.7–1.2 (1 = normal)
ELEVENLABS_STABILITY=0.55
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0
ELEVENLABS_SPEED=1

# ── Marca ──────────────────────────────────────────────
# O @ aparece escrito nos vídeos. A voz nunca lê o @: fala a pronúncia abaixo (vazio = não fala o nome)
BRAND_HANDLE=@vitrine.decasa
BRAND_HANDLE_SPOKEN=Vitrine ponto de casa

# ── Vídeo explicativo ──────────────────────────────────
# Duração alvo (o roteiro é escrito para caber nisso)
EXPLAINER_SECONDS=28
# Narração: escolha UMA voz PT-BR no ElevenLabs (Voice Library) e cole o id em ELEVENLABS_VOICE_ID — vira a voz da marca.
# EXPLAINER_VISION=1 faz o Claude olhar um quadro de cada cena antes do render (+~US$0,05 por vídeo).
EXPLAINER_VISION=0
# Trilha de fundo: lofi (padrão) ou none · volume da trilha (1 = padrão, 0.5 = metade)
EXPLAINER_MUSIC=lofi
EXPLAINER_MUSIC_VOLUME=1

# ── Preços (para o custo exato por vídeo no app) ──────────
ANTHROPIC_USD_PER_MTOK_IN=2
ANTHROPIC_USD_PER_MTOK_OUT=10
# ElevenLabs cobra por caractere do seu plano: (preço do plano em US$ ÷ caracteres do plano) × 1000
ELEVENLABS_USD_PER_1K_CHARS=0.17
# Opcional: mostra também em reais
USD_BRL=0

# ── Vídeo ──────────────────────────────────────────────────
SCENE_SECONDS=5
END_CARD_SECONDS=3
# DATA_DIR=./data
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
